# Copy to terraform.tfvars and edit, or pass -var flags / use the deploy script.
aws_region   = "us-east-1"
service_name = "rag-app"
image_tag    = "latest"

# Compute (must be a valid App Runner cpu/memory pairing).
cpu    = "1024" # 1 vCPU
memory = "3072" # 3 GB

# Backend + Bedrock models (enable these under Bedrock > Model access first).
rag_backend         = "bedrock"
bedrock_embed_model = "amazon.titan-embed-text-v2:0"
bedrock_chat_model  = "anthropic.claude-3-haiku-20240307-v1:0"
rag_pdf_paths       = "gk_ques_ans.pdf"

# Autoscaling.
min_size        = 1
max_size        = 3
max_concurrency = 50