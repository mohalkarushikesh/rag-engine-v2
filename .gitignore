# Python
__pycache__/
*.pyc

# RAG caches:
#   - The FAISS index dirs are regenerable (fast, no OCR) -> ignore them.
#   - The extracted-text sidecar is expensive (OCR) and portable -> KEEP it,
#     so committing it lets OCR never re-run on any machine or CI.
.rag_cache/*/
!.rag_cache/text_*.json

# don't remove this
.venv/

# Local secrets / env (keep your configured .env locally; never commit it)
.env

# Terraform state & local provider cache (never commit state -- it holds secrets)
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
infra/terraform.tfvars
